# Docker Compose settings. For local Python use localhost instead of db.
POSTGRES_PASSWORD=local-face-password
PORT=8080
# Optional DATABASE_URL override (otherwise Compose builds it from the password).
# DATABASE_URL=postgresql+psycopg://face:local-face-password@localhost:5432/face
# Container paths; for local Python use absolute paths to data/ and model/.
DATASET_ROOT=/datasets
MODEL_ROOT=/models
